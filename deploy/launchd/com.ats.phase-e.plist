<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Research-workflow scheduler (Phase F, 2026-10-17): runs ONLY the Dispatcher-owned research workflows
         (information, fundamental, layer, sector, macro, technical) and consumes published calendar events.
         It never enters the Chief decision cycle, never places orders and takes no --live flag.
         Do NOT confuse with com.ats.schedule.plist, which starts the legacy scheduler with `--live`. -->
    <key>Label</key>
    <string>com.ats.phase-e</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/liuchao/.local/bin/uv</string>
        <string>run</string>
        <string>--offline</string>
        <string>--no-sync</string>
        <string>python</string>
        <string>-m</string>
        <string>ats.runtime.cli</string>
        <string>schedule</string>
        <string>--phase-e</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/liuchao/Code/trading/auto_stock_trading_agents</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/liuchao/Code/trading/auto_stock_trading_agents/src</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/liuchao/Code/trading/auto_stock_trading_agents/var/logs/phase-e.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/liuchao/Code/trading/auto_stock_trading_agents/var/logs/phase-e.err.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
