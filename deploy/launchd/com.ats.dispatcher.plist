<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Research dispatcher daemon: runs ONLY the Dispatcher-owned research workflows (information,
         fundamental, layer, sector, macro, technical) on their schedules and on published calendar events.
         It never enters the Chief decision cycle and never places orders. -->
    <key>Label</key>
    <string>com.ats.dispatcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/liuchao/.local/bin/uv</string>
        <string>run</string>
        <string>--offline</string>
        <string>--no-sync</string>
        <string>python</string>
        <string>-m</string>
        <string>ats.runtime.cli</string>
        <string>schedule</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/liuchao/Code/trading/auto_stock_trading_agents</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/liuchao/Code/trading/auto_stock_trading_agents/src</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/liuchao/Code/trading/auto_stock_trading_agents/var/logs/dispatcher.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/liuchao/Code/trading/auto_stock_trading_agents/var/logs/dispatcher.err.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
